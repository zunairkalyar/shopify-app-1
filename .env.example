# Webhook System Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Shop Configuration
SHOP_NAME="MazayLO"
SUPPORT_PHONE="+92-300-1234567"
SUPPORT_EMAIL="support@mazaylo.com"
WEBSITE_URL="https://mazaylo.com"

# Database Configuration
# Choose one: MongoDB or PostgreSQL
DATABASE_URL="mongodb://localhost:27017/webhook-system"
# DATABASE_URL="postgresql://username:password@localhost:5432/webhook_system"

# Redis Configuration (for caching and queues)
REDIS_URL="redis://localhost:6379"

# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-verify-token-here"
ENABLE_WHATSAPP_SENDING=false

# Email Service Configuration (SendGrid)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@mazaylo.com"
ENABLE_EMAIL_SENDING=false

# SMS Service Configuration (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
ENABLE_SMS_SENDING=false

# Security Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
API_KEY="your-api-key-for-webhook-endpoints"
WEBHOOK_SECRET="your-webhook-secret-for-verification"

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE="logs/app.log"
ENABLE_LOGGING=true

# Feature Flags
ENABLE_DATABASE=false
ENABLE_AUTHENTICATION=false
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true

# Storage Configuration
STORAGE_DIR="./data"
MAX_WEBHOOKS_STORED=10000

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# Development Tools
ENABLE_SWAGGER=true
ENABLE_DEBUG=true

# Production Settings (override in production)
# NODE_ENV=production
# LOG_LEVEL=error
# ENABLE_DEBUG=false
# ENABLE_SWAGGER=false
