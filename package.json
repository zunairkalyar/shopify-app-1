{
  "name": "webhook-system",
  "version": "1.0.0",
  "description": "Complete webhook system for processing Shopify order alerts with message templates and data organization",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node tests/test-webhook-system.js",
    "example": "node examples/send-test-webhook.js",
    "setup": "npm install && node scripts/setup.js",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "clean": "rimraf data/*.json logs/*.log"
  },
  "keywords": [
    "webhook",
    "shopify",
    "order-processing",
    "message-templates",
    "whatsapp",
    "email",
    "sms",
    "notification",
    "ecommerce"
  ],
  "author": {
    "name": "Your Name",
    "email": "your.email@domain.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/webhook-system.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "app.js",
    "src/",
    "public/",
    "config/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "test": "tests",
    "example": "examples",
    "lib": "src"
  },
  "homepage": "https://github.com/your-username/webhook-system#readme",
  "bugs": {
    "url": "https://github.com/your-username/webhook-system/issues"
  },
  "config": {
    "port": 3000,
    "host": "localhost"
  },
  "contributors": [
    {
      "name": "Your Name",
      "email": "your.email@domain.com",
      "role": "Developer"
    }
  ]
}
