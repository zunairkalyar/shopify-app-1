{
  "version": 2,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
